# ==============================================================================
# HYNOVA ENTERPRISES — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- AI & GOOGLE CLOUD APIS ---
# GEMINI_API_KEY: Required for Gemini AI Advisor & Quotation Engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. Cloud Run service URL).
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript API & Places Key for Kenya site surveys.
VITE_GOOGLE_MAPS_API_KEY="AIzaSyAAwaPM3xLQrgvFDga5BSEq3lCd1HftD7s"

# --- BACKEND API ARCHITECTURE ---
# VITE_API_BASE_URL: Leave empty when frontend and backend are co-hosted on same origin.
# If deploying frontend to static CDN (e.g. GitHub Pages at hynovaenterprises.com),
# set this to your deployed backend API URL (e.g. https://api.hynovaenterprises.com or Cloud Run URL).
VITE_API_BASE_URL=""

# --- PRODUCTION LIVE SMS GATEWAY PROVIDERS ---
# To enable live SMS OTP delivery to customer mobile devices in Kenya and internationally,
# configure either Twilio or Africa's Talking. If neither is provided, the system
# securely reports delivery as BLOCKED and prompts for setup without exposing simulated codes.

# Option 1: Twilio Verify Service (Recommended for Global & East Africa)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Option 1B: Twilio Programmable SMS
# TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Option 2: Africa's Talking SMS Gateway (Specialized for Kenya & Pan-African Telcos)
# AT_USERNAME="hynova"
# AT_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- SECURITY & CRYPTOGRAPHY ---
# OTP_SECRET_SALT: Pepper salt used for server-side SHA-256 OTP code hashing.
OTP_SECRET_SALT="hynova_prod_salt_2026_x87y21"

# --- PERSISTENT DATABASE STORAGE ---
# SQLite production database is located at data/hynova_production.db
# For multi-instance horizontal scaling with persistent durable storage across container lifecycles:
# DATABASE_URL="postgresql://user:password@host:5432/hynova_production"
